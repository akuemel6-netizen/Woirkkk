-- Anti-Ban Auto Walk Logic
task.spawn(function()
    while task.wait(3) do
        if State.AntiBan.AutoWalk and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local radius = State.AntiBan.WalkRadius
                local randomX = math.random(-radius, radius)
                local randomZ = math.random(-radius, radius)
                local targetPos = root.Position + Vector3.new(randomX, 0, randomZ)
                
                LocalPlayer.Character.Humanoid:MoveTo(targetPos)
            end
        end
    end
end)

